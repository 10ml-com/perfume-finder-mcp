  "keywords": [
    "ai-sdk",
    "vercel-ai-sdk",
    "ai-sdk-tool",
    "ai-sdk-tools",
    "tools",
    "tool-calling",
    "perfume",
    "fragrance",
    "perfume-api",
    "fragrance-api",
    "perfume-mcp",
    "mcp",
    "perfume-recommendation",
    "similar-perfumes",
    "fragrance-notes",
    "fragrantica-alternative"
  ],
  "homepage": "https://10ml.com/perfume-mcp-server",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/10ml-com/perfume-finder-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/10ml-com/perfume-finder-mcp/issues"
  },
  "author": "10ML Team <contact@10ml.com> (https://10ml.com)",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
