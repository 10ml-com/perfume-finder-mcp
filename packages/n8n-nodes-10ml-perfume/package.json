{
  "name": "n8n-nodes-10ml-perfume",
  "version": "1.0.4",
  "description": "n8n community node for the free 10ML Perfume Finder: search perfumes, note pyramids, accords, similar scents, alternatives, notes and houses from the 10ML Fragrance Index. No API key.",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "perfume",
    "fragrance",
    "perfume-api",
    "fragrance-api",
    "perfume-recommendation",
    "similar-perfumes",
    "fragrance-notes",
    "mcp"
  ],
  "license": "MIT",
  "homepage": "https://10ml.com/perfume-mcp-server",
  "author": {
    "name": "10ML Team",
    "email": "contact@10ml.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/10ml-com/perfume-finder-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/10ml-com/perfume-finder-mcp/issues"
  },
  "engines": {
    "node": ">=20.15"
  },
  "scripts": {
    "build": "n8n-node build",
    "build:watch": "tsc --watch",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepublishOnly": "n8n-node prerelease"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [],
    "nodes": [
      "dist/nodes/TenMlPerfume/TenMlPerfume.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "*",
    "eslint": "9.32.0",
    "prettier": "3.6.2",
    "release-it": "^19.0.4",
    "typescript": "5.9.2"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
