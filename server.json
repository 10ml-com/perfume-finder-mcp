{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "com.10ml/perfume-finder",
  "title": "10ML Perfume Finder",
  "description": "Free perfume MCP server and fragrance API: 5,400+ perfumes, note pyramids, accords, similar scents.",
  "websiteUrl": "https://mcp.10ml.com",
  "repository": {
    "url": "https://github.com/10ml-com/perfume-finder-mcp",
    "source": "github"
  },
  "version": "2.3.3",
  "icons": [
    {
      "src": "https://10ml.com/brand/icons/icon-512.png",
      "mimeType": "image/png",
      "sizes": [
        "512x512"
      ]
    },
    {
      "src": "https://10ml.com/brand/icons/icon-128.png",
      "mimeType": "image/png",
      "sizes": [
        "128x128"
      ]
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://mcp.10ml.com/mcp"
    }
  ],
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "@10ml/perfume-finder-mcp",
      "version": "2.3.3",
      "transport": {
        "type": "stdio"
      }
    },
    {
      "registryType": "pypi",
      "registryBaseUrl": "https://pypi.org",
      "identifier": "perfume-finder-mcp",
      "version": "2.3.3",
      "transport": {
        "type": "stdio"
      }
    }
  ]
}
